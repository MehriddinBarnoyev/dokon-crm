# --- Baza ---
DATABASE_URL=postgres://dokon:dokon_secret@127.0.0.1:5433/dokon

# SSL: manzil localhost bo'lsa o'chiq, bulut bazasi bo'lsa yoqiq —
# odatda qo'lda belgilash shart emas. Majburlash kerak bo'lsa: true / false
# DATABASE_SSL=

# --- Server ---
PORT=3000
HOST=0.0.0.0
JWT_SECRET=bu_maxfiy_kalitni_albatta_almashtiring

# --- HTTPS (ixtiyoriy) ---
# Ikkalasi ko'rsatilsa server TLS bilan ko'tariladi.
# Sertifikat yaratish:  npm run cert
# Bo'sh qoldirilsa oddiy HTTP da ishlaydi.
TLS_KEY=
TLS_CERT=

# --- Groq AI ---
# Kalitni console.groq.com/keys dan oling.
# Bir nechta kalitni vergul bilan yozish mumkin — biri limitga urilsa
# tizim keyingisiga o'tadi:
#   GROQ_API_KEY=gsk_birinchi,gsk_ikkinchi
# MUHIM: Groq limitni AKKAUNTGA qo'yadi, kalitga emas. Bitta akkauntning
# kalitlari bir xil kunlik byudjetni bo'lishadi — almashinuv faqat kalitlar
# HAR XIL akkauntdan bo'lganda kvotani oshiradi.
GROQ_API_KEY=

# Modellar (o'zgartirish shart emas).
# GROQ_TEXT_MODEL   — tool calling shart. gpt-oss-120b/20b, qwen3.8-27b ishlaydi.
# GROQ_VISION_MODEL — rasm qabul qilishi shart. Groq'da faqat qwen oilasi.
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
