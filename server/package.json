{
  "name": "dokon-crm-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:migrate": "node dist/migrate.js",
    "db:migrate:dev": "tsx src/migrate.ts",
    "db:schema": "docker exec -i dokon-db psql -U dokon -d dokon -p 5433 -v ON_ERROR_STOP=1 < db/schema.sql && docker exec -i dokon-db psql -U dokon -d dokon -p 5433 -v ON_ERROR_STOP=1 < db/002-search.sql && docker exec -i dokon-db psql -U dokon -d dokon -p 5433 -v ON_ERROR_STOP=1 < db/003-search-staged.sql",
    "db:seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:api": "python3 test-api.py",
    "test:ai": "python3 test-ai.py",
    "cert": "bash scripts/gen-cert.sh"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8.0.3",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "groq-sdk": "^1.6.0",
    "pg": "^8.13.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
